# Runtime media must never be added by future blanket Git staging. Existing tracked images remain tracked.
/public/uploads/
/public/uploads/vendor-docs/
/public/uploads/vendor-appeals/
/storage/private/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
